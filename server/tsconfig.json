{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "../dist",
    "noEmit": false,
    "sourceMap": true,
    "inlineSourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["*"]
    }
  },
  "include": ["**/*.ts"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "sourceMap": true
    },
    "transpileOnly": true,
    "files": true
  }
}
